POSTGRES_DB=talentshift
POSTGRES_USER=talentshift
POSTGRES_PASSWORD=change-this-database-password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
APP_DEMO_EMAIL=demo@talentshift.local
APP_DEMO_PASSWORD=ChangeThisDemoPassword123!
APP_DEMO_USER_ENABLED=true
APP_ADMIN_KEY=change-this-admin-collection-key
APP_ADMIN_USER_ENABLED=false
APP_ADMIN_EMAIL=admin@talentshift.local
APP_ADMIN_PASSWORD=replace-with-a-long-unique-password
JOB_COLLECTION_ON_STARTUP=true
SEED_CANDIDATE_CSV=
JOB_CONTINUOUS_POLL_MS=60000
ARBEITNOW_REFRESH_MINUTES=15
REMOTIVE_REFRESH_MINUTES=30
SEED_REFRESH_MINUTES=10
SEED_BACKFILL_REFRESH_MINUTES=10
JOB_DEDUPLICATION_POLL_MS=600000
SEED_MAXIMUM_JOBS=1000
JOB_EXPIRY_CRON=0 15 */3 * * *
JOB_MAX_AGE_DAYS=45
JOB_TARGET_MINIMUM=20000
JOB_MAX_PAGES_PER_SOURCE=10
# Keyless collectors are the active default. Credential-backed providers stay disabled.
JOB_CREDENTIAL_COLLECTORS_ENABLED=false
JOB_MAXIMUM_JOBS=0
JOB_REGISTRY_CONCURRENCY=24
JOB_REGISTRY_PER_DOMAIN_CONCURRENCY=2
JOB_REGISTRY_BATCH_LIMIT=2500
# Future AI provider extension point. No provider or API key is required now.
AI_ENABLED=false
AI_PROVIDER=none
AI_GLOBAL_CONCURRENCY=24
AI_PER_DOMAIN_CONCURRENCY=2
AI_BATCH_LIMIT=2500
AI_MAXIMUM_JOBS=0
JOB_HTTP_MAX_RESPONSE_BYTES=20971520
JOB_HTTP_MAX_REDIRECTS=3
# Optional approved URL renderer service; leave blank to disable browser fallback.
JOB_BROWSER_RENDERER_URL=
JOB_VERIFICATION_CRON=0 0 12 * * *
JOB_VERIFICATION_ZONE=Asia/Riyadh
JOB_VERIFICATION_CONCURRENCY=8
JOB_ENRICHMENT_POLL_MS=60000
JOB_ENRICHMENT_BATCH_SIZE=100
UPLOAD_MAX_BYTES=5242880

PROXYCURL_API_KEY=your-proxycurl-api-key
CANDIDATE_COLLECTION_ON_STARTUP=true
CANDIDATE_REFRESH_DELAY_MS=86400000
CANDIDATE_MAX_PER_ROLE=20
